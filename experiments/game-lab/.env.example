# local: offline localStorage saves, no internet required.
# supabase: online Supabase saves.
VITE_TRIAL_PERSISTENCE_MODE=local

# Supabase Project Settings > API > Project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Project Settings > API > Publishable key
# Safe for browser builds. Never put the service_role key in Vite/client code.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
